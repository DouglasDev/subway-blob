{
  "name": "subway-blob",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "build": "pnpm run typecheck && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "format": "oxfmt && eslint . --fix",
    "format:check": "eslint . --max-warnings=0 && oxfmt --check",
    "prepare": "husky",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix",
    "test": "node --experimental-transform-types --test --test-isolation=none tests/*.test.ts"
  },
  "dependencies": {
    "@linaria/react": "7.0.1",
    "@rcade/plugin-input-classic": "0.2.4",
    "react": "19.2.5",
    "react-dom": "19.2.5",
    "three": "^0.187.0"
  },
  "devDependencies": {
    "@babel/core": "7.29.7",
    "@babel/preset-react": "7.28.5",
    "@babel/preset-typescript": "7.28.5",
    "@stylistic/eslint-plugin": "5.10.0",
    "@types/node": "^24.19.2",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@types/three": "^0.187.0",
    "@typescript-eslint/parser": "8.72.1",
    "@vitejs/plugin-react": "6.0.1",
    "@wyw-in-js/vite": "1.1.0",
    "eslint": "10.14.0",
    "husky": "9.1.7",
    "oxfmt": "0.72.0",
    "typescript": "6.0.3",
    "vite": "8.3.3"
  },
  "packageManager": "pnpm@10.12.4"
}
